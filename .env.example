# Öffentlicher Host-Port der Nova-App (Container intern immer 8080)
NOVA_PORT=8080
NOVA_IMAGE_TAG=latest

# Optional: Commit-SHA, die das Backend unter /api/version anzeigt
GIT_COMMIT=dev-local

# Öffentliche HTTPS-Basis-URL. Nur in der lokalen .env setzen, nicht committen.
PUBLIC_URL=https://example.com

# Upload-Ordner nur auf dem Server (nicht ins Git)
NOVA_DATA_DIR=./data
NOVA_MAX_UPLOAD_BYTES=41943040
