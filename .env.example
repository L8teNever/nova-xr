# Öffentlicher Host-Port der Nova-App (Container intern immer 8080)
NOVA_PORT=8080

# Öffentliche HTTPS-Basis-URL. Nur in der lokalen .env setzen, nicht committen.
PUBLIC_URL=https://example.com

# Schutz für Upload/Umbenennen/Löschen von Modellen. Leer = Upload deaktiviert.
# Langes Zufallstoken verwenden, z. B.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
UPLOAD_TOKEN=change-me-to-a-long-random-token

# Maximale Upload-Größe in MB und maximale Anzahl gespeicherter Modelle
MAX_UPLOAD_MB=100
MAX_MODELS=50
